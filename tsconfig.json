{
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "declaration": true,
    "target": "ESNext",
    "module": "commonjs",
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
